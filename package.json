{
  "name": "custard",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "custard": "node ./pkgs/command/dist/custard.js",
    "build": "tsc -b tsconfig.build.json",
    "clean": "rimraf -g \"pkgs/**/dist\" \"pkgs/**/*.tsbuildinfo\" \"*.tsbuildinfo\"",
    "test": "pnpm run -r test",
    "test:detailed": "pnpm run test -- --reporter verbose",
    "test:once": "pnpm run test -- run",
    "test:coverage": "pnpm run test -- run --coverage",
    "lint": "eslint pkgs",
    "fix:lint": "eslint --fix .",
    "format": "prettier --write */*/src/**/*.ts",
    "prepare": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@typescript-eslint/parser": "8.70.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-config-love": "^157.0.0",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-no-ignore-returned-union": "^0.6.3",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "^5.0.1"
  },
  "workspaces": [
    "pkgs/*",
    "apps/*"
  ],
  "packageManager": "pnpm@12.5.1"
}
