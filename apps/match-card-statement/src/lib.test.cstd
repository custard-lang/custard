(import test { test})
(import assert)
(importAnyOf lib)

(test
 "parseCardStatementFie"
  (fn ()
    (const
       lines
       [ "\"利用日/キャンセル日\",\"利用店名・商品名\",\"利用者\",\"決済方法\",\"支払区分\",\"利用金額\",\"手数料\",\"支払総額\",\"当月支払金額\",\"翌月以降繰越金額\",\"調整額\",\"当月お支払日\""
         "\"2026/5/31\",\"サ－ビス料金\",\"本人*\",\"カード\",\"1回\",\"23\",\"0\",\"34\",\"45\",\"0\",\"0\",\"2026/7/27\""])

    (const
      actual
     (parseCardStatementFile "test.csv" lines))
    (assert.deepEqual
      actual
      [
        { date: (Temporal.PlainDate.from "2026-05-31")
          name: "サ－ビス料金"
          price: 23}])))

(test
  "parseDatedCashbookExpenditures"
  (fn ()
    (const
      lines
      [
       "26/05/31"
       " サ－ビス料金  23  A"
       " サービス手数料  11  B  # comment"
       " income  +23  A"
       "# This is a comment line"
       "26/06/01"
       " サービス利用料  45  B"])
    (const
      actual
      (parseDatedCashbookExpenditures lines))
    (assert.deepEqual
      actual
      [
        { date: (Temporal.PlainDate.from "2026-05-31")
          items:
          [ { name: "サ－ビス料金" amount: 23 category: "A"}
            { name: "サービス手数料" amount: 11 category: "B"}]}
        { date: (Temporal.PlainDate.from "2026-06-01")
          items:
          [ { name: "サービス利用料" amount: 45 category: "B"}]}])))

(test
  "MatchResults"
  (fn ()
    (const
     cardStatementItems
     [
       { date: (Temporal.PlainDate.from "2026-05-28")
         name: "S11 2026-05-28"
         price: 11}

       { date: (Temporal.PlainDate.from "2026-05-29")
         name: "S11 2026-05-29"
         price: 11}

       { date: (Temporal.PlainDate.from "2026-05-30")
         name: "S23 2026-05-30"
         price: 23}
       { date: (Temporal.PlainDate.from "2026-05-30")
         name: "S11 2026-05-30"
         price: 11}

       { date: (Temporal.PlainDate.from "2026-05-31")
         name: "S11 2026-05-31"
         price: 11}
       { date: (Temporal.PlainDate.from "2026-05-31")
         name: "S23 2026-05-31"
         price: 23}

       { date: (Temporal.PlainDate.from "2026-06-01")
         name: "S9 2026-06-01"
         price: 9}])
    (const
      cashbookLines
      [
       { date: (Temporal.PlainDate.from "2026-05-29")
         items:
         [ { name: "B11 2026-05-29" amount: 11 category: "B"}
           { name: "B11 2026-05-29 2" amount: 11 category: "B"}]}
       { date: (Temporal.PlainDate.from "2026-05-30")
         items:
         [ { name: "B23 2026-05-30" amount: 23 category: "B"}
           { name: "B11 2026-05-30" amount: 11 category: "B"}]}
       { date: (Temporal.PlainDate.from "2026-05-31")
         items:
         [ { name: "B11 2026-05-31" amount: 11 category: "B"}
           { name: "B23 2026-05-31" amount: 23 category: "B"}]}])

    (const
      matchResult
      (matchCardStatementWithCashbookLines
        cardStatementItems
        cashbookLines))

    (const
      serializedResults
      ((matchResult.map serializeMatchResult).join ""))

    (test
      "matchCardStatementWithCashbookLines"
      (fn ()
        (assert.deepEqual
          matchResult
          [ { cardStatementItem: (get cardStatementItems 0)
              matchedLines: []}
            { cardStatementItem: (get cardStatementItems 1)
              matchedLines:
              [ { date: (Temporal.PlainDate.from "2026-05-29")
                  items:
                  [ { name: "B11 2026-05-29" amount: 11 category: "B"}
                    { name: "B11 2026-05-29 2" amount: 11 category: "B"}]}]}
            { cardStatementItem: (get cardStatementItems 2)
              matchedLines:
              [ { date: (Temporal.PlainDate.from "2026-05-30")
                  items:
                  [ { name: "B23 2026-05-30" amount: 23 category: "B"}]}]}
            { cardStatementItem: (get cardStatementItems 3)
              matchedLines:
              [ { date: (Temporal.PlainDate.from "2026-05-29")
                  items:
                  [ { name: "B11 2026-05-29" amount: 11 category: "B"}
                    { name: "B11 2026-05-29 2" amount: 11 category: "B"}]}
                { date: (Temporal.PlainDate.from "2026-05-30")
                  items:
                  [ { name: "B11 2026-05-30" amount: 11 category: "B"}]}]}
            { cardStatementItem: (get cardStatementItems 4)
              matchedLines:
              [ { date: (Temporal.PlainDate.from "2026-05-29")
                  items:
                  [ { name: "B11 2026-05-29" amount: 11 category: "B"}
                    { name: "B11 2026-05-29 2" amount: 11 category: "B"}]}
                { date: (Temporal.PlainDate.from "2026-05-30")
                  items:
                  [ { name: "B11 2026-05-30" amount: 11 category: "B"}]}
                { date: (Temporal.PlainDate.from "2026-05-31")
                  items:
                  [ { name: "B11 2026-05-31" amount: 11 category: "B"}]}]}
            { cardStatementItem: (get cardStatementItems 5)
              matchedLines:
              [ { date: (Temporal.PlainDate.from "2026-05-30")
                  items:
                  [ { name: "B23 2026-05-30" amount: 23 category: "B"}]}
                { date: (Temporal.PlainDate.from "2026-05-31")
                  items:
                  [ { name: "B23 2026-05-31" amount: 23 category: "B"}]}]}
            { cardStatementItem: (get cardStatementItems 6)
              matchedLines: []}])))

    (test
      "serializeMatchResult"
      (fn ()
        (const
          expectedSerializedResults
          [
           "# 2026/5/28  S11 2026-05-28  11\n"
           "\n"
           "# 2026/5/29  S11 2026-05-29  11\n"
           "26/05/29\n"
           " B11 2026-05-29  11  B\n"
           " B11 2026-05-29 2  11  B\n"
           "\n"
           "# 2026/5/30  S23 2026-05-30  23\n"
           "26/05/30\n"
           " B23 2026-05-30  23  B\n"
           "\n"
           "# 2026/5/30  S11 2026-05-30  11\n"
           "26/05/29\n"
           " B11 2026-05-29  11  B\n"
           " B11 2026-05-29 2  11  B\n"
           "26/05/30\n"
           " B11 2026-05-30  11  B\n"
           "\n"
           "# 2026/5/31  S11 2026-05-31  11\n"
           "26/05/29\n"
           " B11 2026-05-29  11  B\n"
           " B11 2026-05-29 2  11  B\n"
           "26/05/30\n"
           " B11 2026-05-30  11  B\n"
           "26/05/31\n"
           " B11 2026-05-31  11  B\n"
           "\n"
           "# 2026/5/31  S23 2026-05-31  23\n"
           "26/05/30\n"
           " B23 2026-05-30  23  B\n"
           "26/05/31\n"
           " B23 2026-05-31  23  B\n"
           "\n"
           "# 2026/6/1  S9 2026-06-01  9\n"
           "\n"])
          
        (assert.deepEqual
          serializedResults
          (expectedSerializedResults.join ""))))

    (test
      "parseMatchResults"
      (fn ()
        (const
         parsedResults
         (parseMatchResults serializedResults))
        (const
          withoutLineNumbers
          (parsedResults.map
           (fn ({cardStatementWithLineNumber matchedLines})
             (const
               cardStatementItem
               { date: cardStatementWithLineNumber.date
                 name: cardStatementWithLineNumber.name
                 price: cardStatementWithLineNumber.price})
             { cardStatementItem matchedLines})))
        (assert.deepEqual withoutLineNumbers matchResult)))

    (test
      "validateMatchResults"
      (fn ()
        (const
          input
          [
           "# 2026/6/30  Overdue  2922\n"
           "26/07/01\n"
           " only one line  2922  B\n"
           "\n"
           "# 2026/6/30  No problem 1  2900\n"
           "26/06/29\n"
           " only one line  2900  B\n"
           "\n"
           "# 2026/6/30  No lines  1000\n"
           "\n"
           "# 2026/6/30  No problem 2  100\n"
           "26/06/29\n"
           " Divided 1  40  B\n"
           "26/06/30\n"
           " Divided 2  60  B\n"
           "\n"
           "# 2026/6/30  Inconsistent price 1  2901\n"
           "26/06/29\n"
           " line  2901  B\n"
           " another line  1  B\n"
           "\n"
           "# 2026/6/30  Inconsistent price 2  2900\n"
           "26/06/29\n"
           " only one line  2899  B\n"
           "\n"])
        (const
          expectedOutput
          [
           { line: 1
             problem: "Overdue: one or more matched dates are after the card statement date."}
           { line: 9
             problem: "No matched lines"}
           { line: 17
             problem: "Inconsistent total price"}
           { line: 22
             problem: "Inconsistent total price"}])
        (const actualOutput [])
        (validateMatchResults
          (parseMatchResults (input.join ""))
          (fn (msg) (actualOutput.push msg)))
        (assert.deepEqual actualOutput expectedOutput)))))
