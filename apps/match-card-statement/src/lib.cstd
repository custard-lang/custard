(import js)
(import common)

(meta.defineMacro
  getColumnIndex
  (columns columnName)
  (meta.quasiQuote
    (scope
      (const index ($columns.indexOf $columnName))
      (if (equals index -1)
        (throw (text "Column not found: " $columnName)))
      index)))

(const
  getColumnValue
  (fn (columns columnIndex)
    (const value (get columns columnIndex))
    (if (isNone value)
      (throw (text "Column not found at " columnIndex)))
    value))

(const
  parseNumber
  (fn (s)
    (const v (Number s))
    (if (Number.isNaN v)
      (throw (text "Invalid number:" s)))
    v))

(const
  getColumnNumberValue
  (fn (columns columnIndex)
   (const valueS (getColumnValue columns columnIndex))
   (parseNumber valueS)))

(const
  cardDateRegExp
  (createRegExp "^(?<year>\\d{4})/(?<month>\\d{1,2})/(?<day>\\d{1,2})$"))

(const
  parseCardDate
  (fn (dateS)
    (const md (dateS.match cardDateRegExp))
    (if (isNone md)
      (throw (text "Invalid date: " dateS)))
    (const {year month day} md.groups)
    (js.new Temporal.PlainDate year month day)))

(const
  getColumnDateValue
  (fn (columns columnIndex)
    (const valueS (getColumnValue columns columnIndex))
    (parseCardDate valueS)))

(const
  parseCardStatementRawLine
  (fn (fileName lineNumber line)
    ((line.split ",").map
     (fn (c)
       (annotate
         "drop the leading and trailing double quotes"
         (c.slice 1 -1))))))

(const
  parseCardStatementHeader
  (fn (fileName line)
    (const columns (parseCardStatementRawLine fileName 1 line))
    (const dateIndex (getColumnIndex columns "利用日/キャンセル日"))
    (const nameIndex (getColumnIndex columns "利用店名・商品名"))
    (const priceIndex (getColumnIndex columns "利用金額"))
    { dateIndex nameIndex priceIndex}))

(const
  parseCardStatementItem
  (fn (fileName lineNumber line header)
    (const columns (parseCardStatementRawLine fileName lineNumber line))
    (const date (getColumnDateValue columns header.dateIndex))
    (const name (getColumnValue columns header.nameIndex))
    (const price (getColumnNumberValue columns header.priceIndex))
    { date name price}))

(export
  (const
    parseCardStatementFile
    (fn (fileName lines)
      (const [head ...restLines] lines)
      (const
        headerIndices
        (parseCardStatementHeader fileName (common.dropBom head)))
      (restLines.map
        (fn (l i)
          (const n (plusF i 2))
          (parseCardStatementItem fileName n l headerIndices))))))

(export
  (const
    parseDatedCashbookExpenditures
    (fn (lines)
      (const datedCashbookLines [])
      (forEach [i line] (lines.entries)
       (const n (plusF i 1))
       (const parseResult (igrepCashbook.parseLine n line[1]))
       (igrepCashbook.continueIfNone parseResult)
       (igrepCashbook.continueAndWarnIfError parseResult)
       (if (equals parseResult.type "date")
         (datedCashbookLines.push
           {date: (igrepCashbook.dateSToPlainDate parseResult.value) items: []})
         (continue))
       (if (and (equals parseResult.type "item") (not parseResult.isIncome))
         (if (equals datedCashbookLines.length 0)
           (throw (text "At line " n ": No date specified for item: " parseResult.name)))
         ((last datedCashbookLines).items.push
            { name: parseResult.name
              amount: parseResult.amount
              category: parseResult.category})))
     datedCashbookLines)))

(export
  (const
    serializeMatchResult
    (fn ({cardStatementItem matchedLines})
      (const {date name price} cardStatementItem)
      (const dateS (text date.year "/" date.month "/" date.day))
      (const header (text "# " dateS "  " name "  " price "\n"))
      (const
        lines
        (matchedLines.flatMap
          (fn ({ date items})
            (const { year month day} date)
            (const yearS ((text (minusF year 2000)).padStart 2 "0"))
            (const monthS ((text month).padStart 2 "0"))
            (const dayS ((text day).padStart 2 "0"))
            (const matchedLinesHeader (text yearS "/" monthS "/" dayS "\n"))
            (const
              matchedLinesBody
              (items.map
                (fn ({name amount category})
                  (text " " name "  " amount "  " category "\n"))))

            [matchedLinesHeader ...matchedLinesBody])))
      (const body (lines.join ""))
      (text header body "\n"))))

(export
  (const
    parseMatchResults
    (fn (contents)
      (let nextLineNumber 1)
      (((contents.trim).split "\n\n").map
        (fn (block i)
          (const lines (block.split "\n"))
          (const [head ...body] lines)
          (const
            trimmedHead
            (head.replace (createRegExp "^#\\s*") ""))
          (const cardEntry (trimmedHead.split "  "))
          (if (notEquals cardEntry.length 3)
            (throw (text "Invalid match result header: " (JSON.stringify head))))
          (const cardStatementWithLineNumber
           { date: (parseCardDate (get cardEntry 0))
             name: (get cardEntry 1)
             price: (Number (get cardEntry 2))
             line: nextLineNumber})
          (assign
            nextLineNumber
            (plusF
              nextLineNumber
              (annotate
                "Since the `contents` is split by two consecutive newlines, add one."
                (plusF 1 lines.length))))
          (if (Number.isNaN cardStatementWithLineNumber.price)
            (throw (text "Invalid price in match result header: " head)))
          (const cashbookLines (parseDatedCashbookExpenditures body))
          { cardStatementWithLineNumber matchedLines: cashbookLines})))))

(export
  (const
    matchCardStatementWithCashbookLines
    (fn (cardStatementItems datedCashbookLines)
      (cardStatementItems.map
        (fn (cardItem)
          (const
            matchedLines
            (datedCashbookLines.flatMap
             (fn (datedLines)
               (if
                (isLessThan
                  ((datedLines.date.until cardItem.date).total "days")
                  0)
                (return []))
               (const
                 matchedItems
                 (datedLines.items.filter
                  (fn (item)
                    (equals item.amount cardItem.price))))
               (if (isLessThan matchedItems.length 1)
                 (return []))
               (return [{date: datedLines.date items: matchedItems}]))))
          (matchedLines.sort
            (fn ({date: d1} {date: d2})
              (Temporal.PlainDate.compare d2 d1)))
          { cardStatementItem: cardItem matchedLines})))))

(export
  (const
    validateMatchResults
    (fn (matchResults consume)
      (forEach
        { cardStatementWithLineNumber: {date name price line}
          matchedLines}
        matchResults
        (const
          { true: overdue false: notOverdue}
          (Object.groupBy
            matchedLines
            (fn (matchedLine)
              (isGreaterThan ((matchedLine.date.since date).total "days") 0))))

        (if (and (not (isNone overdue)) (isGreaterThan overdue.length 0))
          (consume
            { line
              problem:
              "Overdue: one or more matched dates are after the card statement date."})
          (continue))

        (if (or (isNone notOverdue) (isLessThan notOverdue.length 1))
          (consume { line problem: "No matched lines"})
          (continue))
        (const
          totalPrice
          (notOverdue.reduce
            (fn (sum {items})
              (plusF
                sum
                (items.reduce
                  (fn (s {amount}) (plusF s amount)) 0))) 0))
        (if (notEquals totalPrice price)
          (consume
            { line
              problem: "Inconsistent total price"})
          (continue))))))
