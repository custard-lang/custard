(import js)
(import common)

(export
  (const
    isDateLine
    (fn (l)
      (const dateRegExp (createRegExp "^\\d\\d/\\d\\d/\\d\\d\\s*$"))
      (dateRegExp.test l))))

(export
  (const
    dateSToPlainDate
    (fn (dateS)
      (const [yy mm dd] ((dateS.split "/").map (fn (s) (Number s))))
      (note
        (console.error "Debug: dateSToPlainDate called with dateS:" dateS "parsed as yy:" yy "mm:" mm "dd:" dd))
      (const year (andOr (isLessThan yy 100) (plusF 2000 yy) yy))
      (js.new Temporal.PlainDate year mm dd))))

(annotate
  "Parse each line into fields. The format parsed here is rather relaxed than the exact syntax of igrep-cashbook."
  (export
    (const
      parseLine
      (fn (n l)
        (const trimmed (l.trim))

        (if (isDateLine trimmed)
          (return {value: l type: "date"}))

        (if
          (or
            (l.startsWith "#")
            (isLessThan l.length 1))
          (return { value: l type: "commentLine"}))

        (if (not (l.startsWith " "))
          (return (text "At line " n ": Invalid line. Missing a leading space.")))

        (const sep (createRegExp " {2,}"))
        (const fields (trimmed.split sep 3))
        (const [name amountS category] fields)

        (const commentRegExp (createRegExp " #([^#]*)$"))
        (const commentMd (trimmed.match commentRegExp))
        (const comment (andOr (isNone commentMd) none (get commentMd 1)))

        (if (isNone name)
          (return (text "At line " n ": Missing name field.")))
        (if (isNone category)
          (return (text "At line " n ": Missing category field.")))
        (if (isNone amountS)
          (return (text "At line " n ": Missing amount field.")))

        (const reAmount (createRegExp "^(?<isIncome>\\+?)[\\d,_]+$"))
        (const amountMd (amountS.match reAmount))
        (if (isNone amountMd)
          (return (text "At line " n ": Invalid amount field: " amountS)))

        (const reAmountSeparator (createRegExp "[,_]+" "g"))
        (const amount (Number (amountS.replace reAmountSeparator "")))

        (if (isLessThan amount 1)
          (return (text "At line " n ": Invalid amount field: " amount)))

        (const isIncome (equals amountMd.groups.isIncome "+"))
        (return {name category isIncome amount comment type: "item"})))))

(const
  streamFromArgvElement
  (fn (f)
   (andOr (equals f "-")
     process.stdin
     (fsC.createReadStream f))))

(export
  (const
    readStreamsFromArgv
    (fn (argv)
      (const args (argv.slice 2))
      (andOr
        (isGreaterThan args.length 0)
        (args.map streamFromArgvElement)
        [process.stdin]))))

(export
  (const
    readUtf8Lines
    common.readUtf8Lines))

(export
  (meta.defineMacro
    continueIfNone
    (varName)
    (meta.quasiQuote
      (if (isNone $varName)
        (continue)))))

(export
  (meta.defineMacro
    continueAndWarnIfError
    (parseResult)
    (meta.quasiQuote
      (if (isString $parseResult)
        (console.warn $parseResult)
        (continue)))))

(export
  (meta.defineMacro
    continueIfNonItem
    (parseResult)
    (console.log
      "Debug: continueIfNonItem called with parseResult:"
      (meta.quasiQuote $parseResult)
      (meta.quote $parseResult.type))
    [
     ((meta.macroToFunction continueIfNone) parseResult)
     ((meta.macroToFunction continueAndWarnIfError) parseResult)
     (meta.quasiQuote
       (if (notEquals $parseResult.type "item")
         (continue)))]))

(export
  (const
    parseDatedCashbookLines
    (fn (lines)
      (const datedCashbookLines [])
      (forEach [i line] (lines.entries)
       (const n (plusF i 1))
       (const parseResult (parseLine n line[1]))
       (continueIfNone parseResult)
       (continueAndWarnIfError parseResult)
       (if (equals parseResult.type "date")
         (datedCashbookLines.push
           {date: (dateSToPlainDate parseResult.value) items: []})
         (continue))
       (if
         (or
           (equals parseResult.type "item")
           (equals parseResult.type "commentLine"))
         (if (equals datedCashbookLines.length 0)
           (throw (text "At line " n ": No date specified for item: " parseResult.name)))
         ((last datedCashbookLines).items.push parseResult)))
     datedCashbookLines)))

(export
  (const
    groupDatedCashbookLinesByDate
    (fn (datedCashbookLines)
      (const groupedByDate (createMap))
      (forEach datedCashbookLine datedCashbookLines
        (const dateKey (datedCashbookLine.date.toString))
        (if (not (groupedByDate.has dateKey))
          (groupedByDate.set dateKey {date: datedCashbookLine.date items: []}))
        ((groupedByDate.get dateKey).items.push ...datedCashbookLine.items))
      (return groupedByDate))))

(export
  (const
    unparseDatedCashbookLines
    (fn (datedCashbookLines)
      (datedCashbookLines.flatMap
        (fn ({date items})
          (const yearS ((text (minusF date.year 2000)).padStart 2 "0"))
          (const monthS ((text date.month).padStart 2 "0"))
          (const dayS ((text date.day).padStart 2 "0"))
          (const dateLine (text yearS "/" monthS "/" dayS))
          (const itemLines
            (items.map
              (fn (item)
                (if (equals item.type "commentLine")
                  (return item.value))
                (if (notEquals item.type "item")
                  (throw (text "Unexpected item type: " item.type)))
                (const {name amount category comment isIncome} item)
                (const amountS
                  (text
                    (andOr isIncome "+" "")
                    (amount.toString)))
                (const afterCategory
                  (andOr comment (text "  #" comment) ""))
                (text " " name "  " amountS "  " category afterCategory))))
          [dateLine ...itemLines])))))

(export
  (const
    listDatedCashbookLines
    (fn (groupedByDate)
      (const datedLines [...(groupedByDate.values)])
      (note
        "これは想定通りにsortしないので注意。`b`が返ってきてしまう。custardの構文の紛らわしいところ"
        (xs.sort (fn (a b) Temporal.PlainDate.compare a b)))
      (datedLines.sort (fn (a b) (Temporal.PlainDate.compare a.date b.date)))
      (unparseDatedCashbookLines datedLines))))
